@model List<InmobiliariaCC.Models.Propietario>

@{
    ViewData["Title"] = "Lista de Propietarios";
}

<h1>Lista de Propietarios</h1>

<p>
    <a asp-action="Nuevo" class="btn btn-primary">
        Nuevo Propietario
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre Completo</th>
            <th>DNI</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var propietario in Model)
        {
            <tr>
                <td>@propietario.IdPropietario</td>
                <td>@propietario.NombreCompleto</td>
                <td>@propietario.DNI</td>
                <td>@propietario.Telefono</td>
                <td>@propietario.Email</td>

                <td>
                    <a asp-action="Editar"
                       asp-route-id="@propietario.IdPropietario"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@propietario.IdPropietario"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>